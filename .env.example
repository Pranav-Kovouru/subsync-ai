# Keep this file secret in your deployment provider; never expose it to the browser.
# For Google Gemini API (Recommended):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Or for OpenAI API:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Optional: limits accidental large requests. Default is 120 subtitle cues.
MAX_TRANSLATION_CUES=120


